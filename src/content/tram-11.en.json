      "deskAria": "{name} desk",
      "insight": "AI isn’t one know-it-all but a whole team: each kind is good at one job.",
      "detail": "An LLM works mostly with text; an agent is an LLM given extra tools to do several steps on its own.",
      "desks": {
        "text": {
          "name": "Text · LLM",
          "role": "Writer & analyst",
          "caption": "LLM, a large language model: writes, plans strategy, analyzes, takes notes."
        },
        "image": {
          "name": "Image AI",
          "role": "Painter & photographer",
          "caption": "Makes key visuals, illustrations and product shots from one description."
        },
        "video": {
          "name": "Video AI",
          "role": "Filmmaker & editor",
          "caption": "Shoots and edits short clips from text, or makes still images move."
        },
        "3d": {
          "name": "3D AI",
          "role": "Model maker",
          "caption": "Turns a photo or text into a shape you can spin any way."
        },
        "voice": {
          "name": "Voice",
          "role": "Announcer",
          "caption": "Reads scripts, dubs, turns text into a natural voice."
        },
        "agent": {
          "name": "Agent",
          "role": "Self-starting assistant",
          "caption": "An agent: AI given tools, doing several steps for you on its own."
        }
      }
    },
