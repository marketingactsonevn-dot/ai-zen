      "insight": "The right desk is half the job; the other half is checking the results like a manager.",
      "detail": "Big jobs often need several desks: the LLM writes the script, video AI films, voice AI reads the lines.",
      "tasks": [
        {
          "text": "Write a caption for a post",
          "desk": "text",
          "why": "A caption is text: a job for the LLM, the team’s writer.",
          "near": {
            "agent": "An agent could do it, but for plain writing the LLM is simplest."
          }
        },
        {
          "text": "Analyze a sales Excel file",
          "desk": "text",
          "why": "Reading numbers and drawing insights is the strength of the LLM, the team’s analyst."
        },
        {
          "text": "Make a key visual for a campaign",
          "desk": "image",
          "why": "A key visual is a still image: give it to the image AI painter.",
          "near": {
            "video": "Video AI makes moving pictures; a still image suits image AI."
          }
        },
        {
          "text": "Shoot an 8 second product video",
          "desk": "video",
          "why": "Pictures moving over time need video AI, the filmmaker and editor.",
          "near": {
            "image": "Image AI makes just one still frame; 8 seconds of motion is a job for video AI."
          }
        },
        {
          "text": "Build a 3D model of a serum bottle",
          "desk": "3d",
          "why": "A shape you can spin any way is a job for the 3D AI model maker.",
          "near": {
            "image": "A photo shows one angle; a 3D model can be turned to see every side."
          }
        },
        {
          "text": "Record a voice-over for a clip",
          "desk": "voice",
          "why": "Reading aloud is a job for voice AI, the team’s announcer.",
          "near": {
            "text": "The LLM can write the words, but reading them aloud needs voice AI.",
            "video": "Some video AIs add sound, but a separate voice-over is voice AI’s strength."
          }
        },
        {
          "text": "Book a meeting, send emails itself",
          "desk": "agent",
          "why": "Opening the calendar and pressing send on its own takes several steps with tools: an agent’s job.",
          "near": {
            "text": "The LLM can draft the email, but booking and sending on its own needs an agent with tools."
          }
        },
        {
          "text": "An automatic report every morning",
          "desk": "agent",
          "why": "Fetching the numbers and sending a report every morning is a job for the agent, the self-starting assistant.",
          "near": {
            "text": "The LLM writes good reports, but gathering the numbers every morning on its own needs an agent."
          }
        }
      ],
