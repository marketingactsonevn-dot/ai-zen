  "quiz": {
    "q": "Which task needs an agent, not just an LLM?",
    "options": [
      "Write a post caption",
      "Summarize a report",
      "Book a meeting and send invites itself",
      "Translate a paragraph"
    ],
    "answer": 2,
    "explain": "The other three only need writing; opening a calendar and pressing send on its own needs an agent with tools."
  },
