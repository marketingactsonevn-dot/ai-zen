{
  "name": "ai-zen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:en": "LOCALE=en vite --port 5180",
    "build": "tsc --noEmit && vite build && LOCALE=en vite build --outDir dist/en",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "logos:simple-icons": "node scripts/fetch-logos.mjs",
    "deploy": "npm run build && sh scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "gsap": "^3.15.0",
    "matter-js": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.186.0",
    "simple-icons": "^16.35.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
